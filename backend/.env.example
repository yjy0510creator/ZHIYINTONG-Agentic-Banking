# OpenAI 兼容服务端配置；不配置 API Key 时自动使用本地 Mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=35

# 本地演示账户数据（人民币）
DEMO_BALANCE=10000
DEMO_MORTGAGE=3000
DEMO_DAILY_EXPENSE=2000
DEMO_MIN_LIQUIDITY=1000
DEMO_TARGET_TRAVEL_BUDGET=3000

# 本地/演示环境开启模拟 MFA；真实环境必须接入身份认证服务
DEMO_MFA_ENABLED=true
WORKFLOW_TTL_SECONDS=3600

# 逗号分隔的前端 Origin；部署时替换为真实 Vercel 域名
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# 3.0: 默认生产拒绝访问；仅本机模拟演示显式改为 development
APP_ENV=production
# 开发身份独立随机口令，至少 16 字符；禁止放入 NEXT_PUBLIC_* 或提交版本库
DEV_MAKER_PASSWORD=
DEV_CHECKER_PASSWORD=
DEV_CUSTOMER2_PASSWORD=
# 仅新建独立模拟账户使用；不是实际银行余额
SIMULATED_INITIAL_BALANCE=10000
